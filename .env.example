# ==============================================================================
# GENERAL CONFIGURATION
# ==============================================================================
APP_ENV=development

# ==============================================================================
# INTERNAL HOSTS (DOCKER NETWORK)
# ==============================================================================
DB_INTERNAL_HOST=postgres
DB_INTERNAL_PORT=5432
REDIS_INTERNAL_HOST=redis
REDIS_INTERNAL_PORT=6379
KAFKA_INTERNAL_HOST=kafka
KAFKA_INTERNAL_PORT=9092
JAEGER_INTERNAL_HOST=jaeger
JAEGER_INTERNAL_PORT=4317

# ==============================================================================
# DATABASE (POSTGRESQL)
# ==============================================================================
POSTGRES_VERSION=15-alpine
POSTGRES_USER=root
POSTGRES_PASSWORD=rootpassword
POSTGRES_DB=flashsale_master
DB_HOST=localhost
DB_HOST_BIND=127.0.0.1
DB_PORT=15432

DB_PRODUCT=db_product
DB_INVENTORY=db_inventory
DB_ORDER=db_order
DB_PAYMENT=db_payment
DB_AUTH=db_auth

# ==============================================================================
# CACHE (REDIS)
# ==============================================================================
REDIS_VERSION=7-alpine
REDIS_HOST=localhost
REDIS_HOST_BIND=127.0.0.1
REDIS_PORT=16379

# ==============================================================================
# MESSAGE BROKER (KAFKA)
# ==============================================================================
KAFKA_VERSION=3.5.1
KAFKA_HOST=localhost
KAFKA_PORT=19092
KAFKA_EXTERNAL_PORT=19094
KAFKA_UI_PORT=18080
KAFKA_HOST_BIND=127.0.0.1
# Gunakan 'localhost' di laptop lokal, atau IP Publik VPS di Alibaba Cloud VPS
KAFKA_PUBLIC_IP_OR_HOST=localhost

# ==============================================================================
# OBSERVABILITY (JAEGER)
# ==============================================================================
JAEGER_VERSION=latest
JAEGER_HOST=localhost
JAEGER_HOST_BIND=127.0.0.1
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=14317
JAEGER_OTLP_HTTP_PORT=14318

# ==============================================================================
# REVERSE PROXY (NGINX)
# ==============================================================================
NGINX_VERSION=alpine
NGINX_HOST_BIND=127.0.0.1
NGINX_PORT=18081

# ==============================================================================
# MICROSERVICES CONFIGURATION (GRPC / HTTP PORTS)
# ==============================================================================
API_GATEWAY_INTERNAL_PORT=8000
PRODUCT_SERVICE_INTERNAL_PORT=9001
INVENTORY_SERVICE_INTERNAL_PORT=9002
PAYMENT_SERVICE_INTERNAL_PORT=9003
AUTH_SERVICE_INTERNAL_PORT=9004

API_GATEWAY_PORT=18000
PRODUCT_SERVICE_PORT=19001
INVENTORY_SERVICE_PORT=19002
PAYMENT_SERVICE_PORT=19003
AUTH_SERVICE_PORT=19004

API_GATEWAY_HOST=api-gateway
PRODUCT_SERVICE_HOST=product-service
INVENTORY_SERVICE_HOST=inventory-service
PAYMENT_SERVICE_HOST=payment-service
AUTH_SERVICE_HOST=auth-service

# Downstream endpoints used by API Gateway to call backend services
PRODUCT_SERVICE_ENDPOINT=product-service:9001
INVENTORY_SERVICE_ENDPOINT=inventory-service:9002
PAYMENT_SERVICE_ENDPOINT=payment-service:9003
AUTH_SERVICE_ENDPOINT=auth-service:9004
